{
  "name": "proxysetting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply proxysetting --local",
    "db:remote": "wrangler d1 migrations apply proxysetting --remote",
    "verify": "npm run typecheck && npm test && npm run db:local && wrangler deploy --dry-run"
  },
  "dependencies": {
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260930.1",
    "@types/node": "^24.0.0",
    "miniflare": "5.20260926.1-alpha",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "wrangler": "4.144.0"
  }
}
